<UserControl
            x:Class="AESCConstruct2026.UI.RibCutOutControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:AESCConstruct2026.UIMain"
             MinWidth="300"
             Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AESCConstruct2026;component/UIMain/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1) Cutout parameters -->
            <TextBlock Grid.Row="0"
                       Style="{StaticResource TitleTextStyle}"
                       Tag="RibCutoutText"
                       Text="Cutout"
                       Width="230"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0" />

            <StackPanel Margin="10"
                        Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Tag="ToleranceLabel"
                               Text="Tolerance"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBox Tag="ToleranceInput"
                             x:Name="ToleranceInput"
                             Width="60"
                             Text="0" />
                    <local:InfoIcon HelpKey="Help_Rib_Tolerance" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">
                    <CheckBox Tag="ReverseDirectionText"
                              Content="Reverse direction"
                              x:Name="ReverseDirection"
                              IsChecked="{Binding ReverseDirection}" />
                    <local:InfoIcon HelpKey="Help_Rib_ReverseDirection" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">
                    <CheckBox Tag="MiddleToleranceText"
                              Content="Middle Tolerance"
                              x:Name="MiddleTolerance"
                              IsChecked="{Binding MiddleTolerance}" />
                    <local:InfoIcon HelpKey="Help_Rib_MiddleTolerance" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">
                    <CheckBox x:Name="PerpendicularCut"
                              Tag="PerpendicularCutText"
                              Content="Perpendicular Cut" />
                    <local:InfoIcon HelpKey="Help_Rib_PerpendicularCut" />
                </StackPanel>
            </StackPanel>

            <Separator Grid.Row="2"
                       Margin="0,10,0,0" />

            <!-- 2) Weld-round parameters -->
            <TextBlock Grid.Row="3"
                       Style="{StaticResource TitleTextStyle}"
                       Tag="WeldRoundText"
                       Text="Weld Round"
                       Width="230"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0" />

            <Grid Margin="0,10,0,10"
                  Grid.Row="4">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                    <CheckBox Tag="AddWeldRoundText"
                              x:Name="AddWeldRound"
                              Content="Add Weld Round"
                              IsChecked="{Binding AddWeldRound}"
                              VerticalAlignment="Center" />
                    <local:InfoIcon HelpKey="Help_Rib_AddWeldRound" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,0"
                            Grid.Row="0"
                            Grid.Column="1">
                    <Image Source="pack://application:,,,/AESCConstruct2026;component/RibCutout/UI/images/Icon-Radius.png"
                           Width="25"
                           Height="25"
                           Margin="0,0,5,0" />
                    <TextBox Tag="RadiusInput"
                             x:Name="RadiusInput"
                             Width="40"
                             Text="0"
                             Margin="0,0,0,0" />
                    <local:InfoIcon HelpKey="Help_Rib_Radius" />
                </StackPanel>
                <!--<CheckBox Tag="WeldRoundReverseText"
                          Content="Reverse direction"
                          IsChecked="{Binding WeldRoundReverse}"
                          Margin="0,0,0,0"
                          Grid.Row="1"
                          Grid.Column="0"/>-->
            </Grid>

            <!-- 3) Create button -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button x:Name="CreateButton"
                        Tag="CreateText"
                        Content="Create"
                        Style="{StaticResource FooterButtonStyle}"
                        Width="100"
                        Click="CreateButton_Click" />
                <local:InfoIcon HelpKey="Help_Rib_Create"
                                VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
