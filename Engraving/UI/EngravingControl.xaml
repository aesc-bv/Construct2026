<UserControl x:Class="AESCConstruct2026.UI.EngravingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AESCConstruct2026.UIMain"
             MinWidth="300"
             Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/AESCConstruct2026;component/UIMain/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- main section -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- bottom buttons -->
            </Grid.RowDefinitions>

            <!-- Main options -->
            <TextBlock Grid.Row="0"
                       Style="{StaticResource TitleTextStyle}"
                       Tag="Engraving"
                       Text="Engraving"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0" />

            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0">
                <!-- Radio choices -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <RadioButton Style="{x:Null}"
                                 x:Name="RadioComponentName"
                                 Tag="RadioComponentName"
                                 Content="Component Name"
                                 GroupName="NoteSource"
                                 IsChecked="{Binding UseComponentName}"
                                 Margin="0,0,0,4"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Grid.Column="0"
                                 Grid.Row="0"/>
                    <local:InfoIcon HelpKey="Help_Engrave_SourceComponentName"
                                    Grid.Column="1"
                                    Grid.Row="0" />
                    <RadioButton Style="{x:Null}"
                                 x:Name="RadioBodyName"
                                 Tag="RadioBodyName"
                                 Content="Body Name"
                                 GroupName="NoteSource"
                                 IsChecked="{Binding UseBodyName}"
                                 Margin="0,0,0,4"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Grid.Column="0"
                                 Grid.Row="1" />
                    <local:InfoIcon HelpKey="Help_Engrave_SourceBodyName"
                                    Grid.Column="1"
                                    Grid.Row="1" />
                    <RadioButton Style="{x:Null}"
                                 x:Name="RadioCustom"
                                 Tag="RadioCustom"
                                 Content="Custom"
                                 GroupName="NoteSource"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding UseCustomText}"
                                 Grid.Column="0"
                                 Grid.Row="2" />
                    <local:InfoIcon HelpKey="Help_Engrave_SourceCustom"
                                    Grid.Column="1"
                                    Grid.Row="2" />
                    <TextBox Text="{Binding CustomText}"
                             Margin="0,0,0,0"
                             IsEnabled="{Binding IsChecked, ElementName=RadioCustom}"
                             Grid.Column="2"
                             Grid.Row="2" />
                </Grid>

                <!-- Engraving / CutOut -->
                <UniformGrid Columns="2"
                            Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="EngravingCheckBox"
                                  Tag="EngravingCheckBox"
                                  Content="Engraving"
                                  IsChecked="{Binding Engraving}"
                                  Margin="0"
                                  VerticalAlignment="Center" />
                        <local:InfoIcon HelpKey="Help_Engrave_ModeEngraving" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="CutOutCheckBox"
                                  Tag="CutOutCheckBox"
                                  Content="CutOut"
                                  IsChecked="{Binding CutOut}"
                                  Margin="0"
                                  VerticalAlignment="Center" />
                        <local:InfoIcon HelpKey="Help_Engrave_ModeCutOut" />
                    </StackPanel>
                </UniformGrid>

                <!-- Font selector -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Font"
                               Tag="FontText"
                               VerticalAlignment="Center"
                               Width="111"
                               Grid.Column="0" />
                    <local:InfoIcon HelpKey="Help_Engrave_Font"
                                    Grid.Column="1" />
                    <ComboBox x:Name="FontComboBox"
                              Margin="0"
                              Grid.Column="2"
                              ItemsSource="{Binding FontOptions}"
                              SelectedItem="{Binding SelectedFont}"
                              Style="{StaticResource ComboBoxFlatStyle}" />
                </Grid>

                <!-- Size -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Size"
                               Tag="EngravingSizeText"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               Width="106"
                              Grid.Column="0" />
                    <local:InfoIcon HelpKey="Help_Engrave_Size"
                                    Grid.Column="1" />
                    <TextBox x:Name="SizeTextBox"
                             Grid.Column="2"
                             Margin="0"
                             Text="{Binding Size}" />
                </Grid>

                <!-- Center -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <CheckBox x:Name="CenterCheckBox"
                              Tag="CenterCheckBox"
                              Content="Center"
                              IsChecked="{Binding Center}"
                              Margin="0"
                              VerticalAlignment="Center" />
                    <local:InfoIcon HelpKey="Help_Engrave_Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,10">
                    <Button x:Name="AddNoteButton"
                            Tag="AddNoteButton"
                            Style="{StaticResource FooterButtonStyle}"
                            Content="Create"
                            Width="140"
                            Click="AddNoteButton_Click" />
                    <local:InfoIcon HelpKey="Help_Engrave_Create"
                                    VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Separator Grid.Row="2"
                       Margin="0,10,0,0" />

            <TextBlock Grid.Row="3"
                       Style="{StaticResource TitleTextStyle}"
                       Tag="Imprint"
                       Text="Imprint"
                       Width="230"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0" />
            <!-- Bottom buttons -->
            <StackPanel Grid.Row="4"
                        Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImprintBodyButton"
                            Width="140"
                            Tag="ImprintBodyButton"
                            Style="{StaticResource FooterButtonStyle}"
                            Content="Imprint Body"
                            Click="ImprintBodyButton_Click" />
                    <local:InfoIcon HelpKey="Help_Engrave_ImprintBody"
                                    VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImprintLinesButton"
                            Width="140"
                            Tag="ImprintLinesButton"
                            Style="{StaticResource FooterButtonStyle}"
                            Content="Imprint Lines"
                            Click="ImprintLinesButton_Click" />
                    <local:InfoIcon HelpKey="Help_Engrave_ImprintLines"
                                    VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImprintToEngravingButton"
                            Tag="ImprintToEngravingButton"
                            Width="140"
                            Style="{StaticResource FooterButtonStyle}"
                            Content="Imprint to Engraving"
                            Click="ImprintToEngravingButton_Click" />
                    <local:InfoIcon HelpKey="Help_Engrave_ImprintToEngraving"
                                    VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
